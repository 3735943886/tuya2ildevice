{
  "description": "Command validation vectors for il.md section 5. Each case gives the state (the values the producer currently holds, default none), a write, and either the canonical value the driver must receive or the Reject code. A trigger is accepted with value null.",
  "descriptor": {
    "il": 0,
    "id": "00000000-0000-0000-0000-000000000000",
    "props": {
      "power": {
        "type": "binary",
        "rw": true,
        "role": "on"
      },
      "target": {
        "type": "number",
        "rw": true,
        "min": 30,
        "max": 70,
        "step": 1,
        "unit": "%"
      },
      "setpoint": {
        "type": "number",
        "rw": true,
        "min": 16,
        "max": 30,
        "step": 0.5,
        "unit": "°C"
      },
      "off_timer": {
        "type": "number",
        "rw": true,
        "min": 0,
        "max": 540,
        "step": 60,
        "unit": "min"
      },
      "free": {
        "type": "number",
        "rw": true
      },
      "mode": {
        "type": "select",
        "rw": true,
        "options": [
          "smart",
          "jet",
          "silent"
        ]
      },
      "note": {
        "type": "text",
        "rw": true
      },
      "tank_full": {
        "type": "binary"
      },
      "remote_start": {
        "type": "binary"
      },
      "start": {
        "type": "trigger",
        "requires": "remote_start"
      },
      "restart": {
        "type": "trigger"
      },
      "press": {
        "type": "event",
        "options": [
          "single",
          "double"
        ]
      },
      "eco": {
        "type": "binary",
        "rw": true,
        "requires": {
          "prop": "mode",
          "in": [
            "smart",
            "silent"
          ]
        }
      }
    }
  },
  "cases": [
    {
      "name": "binary true",
      "rule": "C-2",
      "state": {},
      "prop": "power",
      "value": true,
      "expect": {
        "accept": true
      }
    },
    {
      "name": "binary on normalised",
      "rule": "C-2",
      "state": {},
      "prop": "power",
      "value": "on",
      "expect": {
        "accept": true
      }
    },
    {
      "name": "binary off normalised",
      "rule": "C-2",
      "state": {},
      "prop": "power",
      "value": "off",
      "expect": {
        "accept": false
      }
    },
    {
      "name": "binary 1 normalised",
      "rule": "C-2",
      "state": {},
      "prop": "power",
      "value": 1,
      "expect": {
        "accept": true
      }
    },
    {
      "name": "binary 0 normalised",
      "rule": "C-2",
      "state": {},
      "prop": "power",
      "value": "0",
      "expect": {
        "accept": false
      }
    },
    {
      "name": "binary garbage",
      "rule": "C-4",
      "state": {},
      "prop": "power",
      "value": "maybe",
      "expect": {
        "reject": "invalid_value"
      }
    },
    {
      "name": "unknown property",
      "rule": "C-1",
      "state": {},
      "prop": "nope",
      "value": 1,
      "expect": {
        "reject": "unknown_property"
      }
    },
    {
      "name": "read only property",
      "rule": "C-1",
      "state": {},
      "prop": "tank_full",
      "value": true,
      "expect": {
        "reject": "read_only"
      }
    },
    {
      "name": "event is never writable",
      "rule": "P-3",
      "state": {},
      "prop": "press",
      "value": "single",
      "expect": {
        "reject": "read_only"
      }
    },
    {
      "name": "number in range",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 50,
      "expect": {
        "accept": 50
      }
    },
    {
      "name": "number at min inclusive",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 30,
      "expect": {
        "accept": 30
      }
    },
    {
      "name": "number at max inclusive",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 70,
      "expect": {
        "accept": 70
      }
    },
    {
      "name": "number below min",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 29,
      "expect": {
        "reject": "out_of_range"
      }
    },
    {
      "name": "number above max",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 71,
      "expect": {
        "reject": "out_of_range"
      }
    },
    {
      "name": "integral float is canonical integer",
      "rule": "C-2",
      "state": {},
      "prop": "target",
      "value": 50.0,
      "expect": {
        "accept": 50
      }
    },
    {
      "name": "number not a number",
      "rule": "C-4",
      "state": {},
      "prop": "target",
      "value": "hot",
      "expect": {
        "reject": "invalid_value"
      }
    },
    {
      "name": "number not finite",
      "rule": "C-4",
      "state": {},
      "prop": "target",
      "value": "NaN",
      "expect": {
        "reject": "invalid_value"
      }
    },
    {
      "name": "number off step is refused, not rounded",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 50.5,
      "expect": {
        "reject": "bad_step"
      }
    },
    {
      "name": "half step accepted",
      "rule": "C-3",
      "state": {},
      "prop": "setpoint",
      "value": 22.5,
      "expect": {
        "accept": 22.5
      }
    },
    {
      "name": "half step refused",
      "rule": "C-3",
      "state": {},
      "prop": "setpoint",
      "value": 22.3,
      "expect": {
        "reject": "bad_step"
      }
    },
    {
      "name": "step counted from min",
      "rule": "C-3",
      "state": {},
      "prop": "off_timer",
      "value": 120,
      "expect": {
        "accept": 120
      }
    },
    {
      "name": "step off min",
      "rule": "C-3",
      "state": {},
      "prop": "off_timer",
      "value": 90,
      "expect": {
        "reject": "bad_step"
      }
    },
    {
      "name": "no range no step: any finite number",
      "rule": "C-1",
      "state": {},
      "prop": "free",
      "value": -3.25,
      "expect": {
        "accept": -3.25
      }
    },
    {
      "name": "range checked before step",
      "rule": "C-1",
      "state": {},
      "prop": "target",
      "value": 100.5,
      "expect": {
        "reject": "out_of_range"
      }
    },
    {
      "name": "select listed",
      "rule": "C-1",
      "state": {},
      "prop": "mode",
      "value": "jet",
      "expect": {
        "accept": "jet"
      }
    },
    {
      "name": "select unlisted",
      "rule": "C-1",
      "state": {},
      "prop": "mode",
      "value": "turbo",
      "expect": {
        "reject": "invalid_value"
      }
    },
    {
      "name": "text any non-empty",
      "rule": "C-1",
      "state": {},
      "prop": "note",
      "value": "hello",
      "expect": {
        "accept": "hello"
      }
    },
    {
      "name": "text empty is not a value",
      "rule": "V-2",
      "state": {},
      "prop": "note",
      "value": "",
      "expect": {
        "reject": "invalid_value"
      }
    },
    {
      "name": "trigger any payload",
      "rule": "C-1",
      "state": {},
      "prop": "restart",
      "value": "",
      "expect": {
        "accept": null
      }
    },
    {
      "name": "trigger with payload",
      "rule": "C-1",
      "state": {},
      "prop": "restart",
      "value": {
        "x": 1
      },
      "expect": {
        "accept": null
      }
    },
    {
      "name": "requires unmet: not yet reported",
      "rule": "C-1",
      "state": {},
      "prop": "start",
      "value": "",
      "expect": {
        "reject": "requires_unmet"
      }
    },
    {
      "name": "requires unmet: false",
      "rule": "C-1",
      "state": {
        "remote_start": false
      },
      "prop": "start",
      "value": "",
      "expect": {
        "reject": "requires_unmet"
      }
    },
    {
      "name": "requires met",
      "rule": "C-1",
      "state": {
        "remote_start": true
      },
      "prop": "start",
      "value": "",
      "expect": {
        "accept": null
      }
    },
    {
      "name": "read only wins over requires",
      "rule": "C-1",
      "state": {},
      "prop": "tank_full",
      "value": true,
      "expect": {
        "reject": "read_only"
      }
    },
    {
      "name": "select requires met",
      "rule": "C-1",
      "state": {
        "mode": "smart"
      },
      "prop": "eco",
      "value": true,
      "expect": {
        "accept": true
      }
    },
    {
      "name": "select requires met by any listed value",
      "rule": "C-1",
      "state": {
        "mode": "silent"
      },
      "prop": "eco",
      "value": false,
      "expect": {
        "accept": false
      }
    },
    {
      "name": "select requires unmet",
      "rule": "C-1",
      "state": {
        "mode": "jet"
      },
      "prop": "eco",
      "value": true,
      "expect": {
        "reject": "requires_unmet"
      }
    },
    {
      "name": "select requires unmet: not reported",
      "rule": "C-1",
      "state": {},
      "prop": "eco",
      "value": true,
      "expect": {
        "reject": "requires_unmet"
      }
    }
  ]
}
