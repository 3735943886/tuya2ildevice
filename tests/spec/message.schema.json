{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IL message (version 0)",
  "description": "il-messages.md section 1. A receiver ignores an unknown msg (W-3).",
  "type": "object",
  "required": [
    "msg"
  ],
  "properties": {
    "msg": {
      "type": "string"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "prop": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "msg": {
            "const": "descriptor"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "descriptor"
        ],
        "properties": {
          "descriptor": {
            "$ref": "descriptor.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "remove"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "value"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id",
          "prop",
          "value"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prop": {
            "$ref": "#/$defs/prop"
          },
          "value": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "absent"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id",
          "prop"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prop": {
            "$ref": "#/$defs/prop"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "event"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id",
          "prop",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prop": {
            "$ref": "#/$defs/prop"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "reject"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id",
          "prop",
          "code"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prop": {
            "$ref": "#/$defs/prop"
          },
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "presence"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "source",
          "online"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "online": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "command"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [
          "id",
          "prop"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prop": {
            "$ref": "#/$defs/prop"
          },
          "value": {
            "type": [
              "boolean",
              "number",
              "string",
              "object",
              "array",
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "msg": {
            "const": "sync"
          }
        },
        "required": [
          "msg"
        ]
      },
      "then": {
        "required": [],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  ]
}
